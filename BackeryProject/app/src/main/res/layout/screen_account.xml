<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        app:cardCornerRadius="60dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            android:contentDescription="Аватар пользователя" />
    </androidx.cardview.widget.CardView>

    <!-- Блок для авторизованного пользователя -->
    <LinearLayout
        android:id="@+id/layout_authorized"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Никнейм"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textSize="16sp"
            android:textColor="#795548"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Рейтинг: 5.00"
                android:textSize="18sp"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:layout_marginEnd="24dp" />

            <TextView
                android:id="@+id/tv_order_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Заказов: 0"
                android:textSize="18sp"
                android:textColor="#3E2723" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_go_to_cart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Перейти в корзину"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выйти"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#D32F2F" />
    </LinearLayout>

    <!-- Блок для гостя -->
    <LinearLayout
        android:id="@+id/layout_guest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вы зашли как гость"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_login_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Войти в аккаунт"
            android:backgroundTint="#5D4037" />
    </LinearLayout>

</LinearLayout>
