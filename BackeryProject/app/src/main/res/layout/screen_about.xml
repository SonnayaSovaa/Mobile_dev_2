<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_about_logo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerInside"
            android:contentDescription="Логотип CatBake" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="О компании «CatBake»"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Наша главная цель — выпекать самый вкусный, ароматный и хрустящий хлеб, круассаны и пончики в городе, используя исключительно натуральные ингредиенты высшего качества.\n\nМы придерживаемся принципов честности, традиционных рецептур и бесконечной любви к своему делу. Каждый день наши мастера создают кулинарные шедевры специально для вас."
            android:textColor="@color/dark_brown"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_about_to_catalog"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Перейти в каталог"
            android:textColor="@color/white"
            android:backgroundTint="@color/dark_brown"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_yellow"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Контакты:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Телефон: +7 (999) 123-45-67\n✉️ Email: info@bakery.ru\n🌐 Сайт: www.bakery.ru"
            android:textColor="@color/light_brown"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2"/>
    </LinearLayout>
</ScrollView>